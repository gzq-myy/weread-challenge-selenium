# General Settings
DEBUG=false
WEREAD_USER=weread-default
WEREAD_DURATION=10-100
WEREAD_SPEED=slow
WEREAD_HEADLESS=true
WEREAD_SCREENSHOT=true
WEREAD_DATA_DIR=./.weread

# Book Selection
# DEFAULT_BOOK_URL has higher priority. If empty, WEREAD_KEYWORDS is required.
# DEFAULT_BOOK_URL=https://weread.qq.com/web/reader/276323e0813ab90a5g0144d7
# Use comma-separated keywords to find books from "我的书架".
WEREAD_KEYWORDS=明朝,三体

# Browser Settings
# Patchright only supports Chromium-based browsers here.
# Options: chrome, MicrosoftEdge
WEREAD_BROWSER=chrome

# Bark Notification Settings
BARK_KEY=
BARK_SERVER=https://api.day.app

# Webhook Notification Settings
WEBHOOK_URL=
